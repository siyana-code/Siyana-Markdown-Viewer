# Normalize line endings for text files in the repository.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never diff or line-ending convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.exe  binary
*.msi  binary
*.AppImage binary
*.deb  binary
*.rpm  binary
*.dmg  binary

# Lockfiles: keep them out of language stats and diffs where noise dominates.
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml   linguist-generated=true -diff
yarn.lock        linguist-generated=true -diff
Cargo.lock       linguist-generated=true -diff

# Docs generated by tooling.
docs/api/** linguist-generated=true