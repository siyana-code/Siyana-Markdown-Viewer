# pnpm configuration for this repository.
#
# This file exists for the registry keys below ONLY. The install behaviour that
# actually matters — fetch timeouts, retries, the isolated node_modules layout —
# is set in `pnpm-workspace.yaml`, because pnpm 11 reads its settings from there
# and treats `.npmrc` as legacy for anything beyond registry and auth. That is not
# a preference: `pnpm config get fetch-timeout` returned `120000` while these keys
# sat here, and the install failed on exactly the timeout they were meant to fix.
#
# Do not duplicate a setting across the two files. The one that is read wins and
# the other is a comment that looks like it works.

# `strict-peer-dependencies` is here rather than in pnpm-workspace.yaml only
# because it is also honoured by npm, and a contributor who opens the repository
# with npm rather than pnpm should still get a failure rather than a silently
# wrong tree. The repository pins `packageManager`, so pnpm is the expected tool.
strict-peer-dependencies=true