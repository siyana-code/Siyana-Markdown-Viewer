{
  "$schema": "https://json.schemastore.org/markdownlint-cli2.jsonc",
  "config": {
    "default": true,

    // --- Disabled, with reasons ------------------------------------------------
    // These rules fight patterns this documentation legitimately uses. Turning
    // them on would produce hundreds of findings and train us to ignore CI.

    // MD013 line length: tables and reference links routinely exceed 100
    // columns and wrapping them hurts readability more than it helps.
    "MD013": false,

    // MD022/MD031/MD032 blank lines around headings/lists/fences: the research
    // corpus uses compact tables and tight list formatting inside cells.
    "MD022": false,
    "MD031": false,
    "MD032": false,

    // MD033 inline HTML: anchor tags are used for stable cross-references.
    "MD033": false,

    // MD036 emphasis-as-heading: risk rows use `**Likelihood 2 · Impact 4**` as
    // a visual label rather than a section heading, which is correct there.
    "MD036": false,

    // MD038/MD049 emphasis style: the corpus mixes `**bold**` and `_italic_`
    // intentionally to distinguish emphasis from strong within a table cell.
    "MD038": false,
    "MD049": false,

    // MD004 list marker style: unordered lists mix `-` and `*` by nesting depth.
    "MD004": false,

    // MD025 single H1: documents open with a title line then metadata, and some
    // sections legitimately restate a heading.
    "MD025": false,

    // MD028/MD029 blank line in blockquote / ordered list prefix: used by the
    // risk and question registers.
    "MD028": false,
    "MD029": false,

    // --- Enforced --------------------------------------------------------------
    // These catch real defects rather than style preferences.
    //
    // MD040: a fenced block with no language cannot be syntax-highlighted and
    // usually means the author pasted something without thinking about it.
    "MD040": true,

    // MD047: missing trailing newline causes noisy diffs.
    "MD047": true,

    // MD034 bare URLs: they must be angle-bracketed or linked so they are
    // clickable and do not break autolinking.
    "MD034": true,

    // MD001 heading increment: skipping levels breaks the accessibility tree.
    "MD001": { "front_matter_title": "^\\s*#\\s" },

    // MD003 heading style: ATX only, consistently.
    "MD003": { "style": "atx" },

    // MD009 trailing spaces: allowed exactly two, which is a Markdown hard
    // line break and therefore meaningful.
    "MD009": { "br_spaces": 2, "list_item_empty_lines": false },

    // MD010 hard tabs.
    "MD010": { "code_blocks": false, "spaces_per_tab": 2 },

    // MD012 multiple consecutive blank lines.
    "MD012": { "maximum": 2 },

    // MD024 duplicate headings are fine when they are siblings (different
    // sections may each have an "Example" or "Verification").
    "MD024": { "siblings_only": true },

    // MD041 first line in file should be a top-level heading.
    "MD041": false,

    // MD046 fenced code blocks everywhere.
    "MD046": { "style": "fenced" },

    // MD051 link fragments must resolve. This is the rule that catches the
    // broken anchors research documents accumulate as they are edited.
    "MD051": true,

    // MD052 reference links and images should use a label defined by the
    // document.
    "MD052": true,

    // MD053 link reference definitions must be used.
    "MD053": true,

    // MD056 table column count must be consistent.
    "MD056": { "style": "compact" },

    // MD060 table pipe spacing: the corpus deliberately uses dense tables, and
    // this rule reported over 4,500 findings to enforce cosmetic alignment.
    "MD060": false,

    // MD058 tables should be surrounded by blank lines.
    "MD058": true,

    // MD059 link text should be descriptive rather than "here" or "click here".
    "MD059": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/.next/**",
    "vendor/**",
    "**/test-fixtures/**",
    "**/fuzz/**",
    "**/corpus/**"
  ]
}